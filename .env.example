OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# --- opcionais (v1.3) ---
# Limite de texto enviado ao A3 por chamada
OPENAI_MAX_INPUT_CHARS=300000
# Cliente da API: timeout (s) e tentativas com espera crescente em 408/409/429/5xx
OPENAI_TIMEOUT_S=300
OPENAI_MAX_RETRIES=4
# Extração: single (uma chamada) ou sectioned (janelas de páginas + fusão; experimental)
OPENAI_EXTRACTION_MODE=single
SECTION_CHARS=80000
# Guardrail anti-veredito: camada 2 (classificador LLM) sobre a síntese e a Consulta
VERDICT_LLM_CHECK=true
# Corte de confiança do juiz semântico do A5 (ver python -m evaluation.calibration)
A5_MIN_CONFIDENCE=0.7
# LGPD: mascarar CPF, e-mail e telefone antes do envio ao provedor
REDACT_PII=true
# Preços (US$ por milhão de tokens) para estimar custo na Auditoria; vazio = sem estimativa
OPENAI_PRICE_INPUT_PER_MTOK=
OPENAI_PRICE_OUTPUT_PER_MTOK=
OCR_MAX_PAGES=40
